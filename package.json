{
  "name": "buildora",
  "version": "0.1.0",
  "private": true,
  "description": "Buildora — Creative components for serious developers. Build. Remix. Ship.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @buildora/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @buildora/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "registry:smoke": "tsx scripts/smoke-registry.ts",
    "registry:e2e": "tsx scripts/compile-e2e.ts",
    "registry:verify-install": "tsx scripts/verify-install.ts",
    "registry:verify-install:matrix": "tsx scripts/verify-install.ts --matrix",
    "registry:audit": "tsx scripts/audit-registry.ts"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "culori": "^4.0.2",
    "glob": "^13.0.6",
    "next": "^14.2.35",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  }
}